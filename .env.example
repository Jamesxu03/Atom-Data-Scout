# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Companies House — https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Web search provider (fill in whichever you pick)
SEARCH_API_KEY=

# Supabase (phase 2) — Project Settings > API
SUPABASE_URL=
# service_role key: worker only, never in frontend code
SUPABASE_SERVICE_ROLE_KEY=
